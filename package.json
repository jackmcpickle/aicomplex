{
  "name": "aicomplex",
  "version": "0.0.8",
  "description": "AI Code Complexity Checker — measure how much slop a codebase is carrying, from the point of view of an AI agent working in it.",
  "keywords": [
    "agents",
    "ai-slop",
    "code-quality",
    "complexity",
    "static-analysis",
    "tree-sitter"
  ],
  "homepage": "https://github.com/jackmcpickle/aicomplex#readme",
  "bugs": {
    "url": "https://github.com/jackmcpickle/aicomplex/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmcpickle/aicomplex.git"
  },
  "bin": {
    "aicomplex": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ignore": "^7.0.6",
    "tinyglobby": "^0.2.17",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commit-and-tag-version": "^13.1.2",
    "eslint-plugin-crap": "^0.1.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.13",
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "bunx oxfmt CHANGELOG.md"
    }
  }
}
