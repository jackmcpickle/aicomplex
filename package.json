{
  "name": "aic3",
  "version": "0.0.1",
  "description": "AI Code Complexity Checker — measure how much slop a codebase is carrying, from the point of view of an AI agent working in it.",
  "keywords": [
    "agents",
    "ai-slop",
    "code-quality",
    "complexity",
    "static-analysis",
    "tree-sitter"
  ],
  "license": "MIT",
  "bin": {
    "aic3": "./dist/cli.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "ignore": "^7.0.5",
    "tinyglobby": "^0.2.15",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.7",
    "commit-and-tag-version": "^13.1.2",
    "eslint-plugin-crap": "^0.1.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "ultracite": "7.10.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
